{
    "name": "laravel-app",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.4.1",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "types": "vue-tsc --noEmit",
        "format": "prettier --write resources/js",
        "format:check": "prettier --check resources/js",
        "postinstall": "cp -n .env.example .env | true"
    },
    "dependencies": {
        "@headlessui/react": "^2.2.10",
        "@headlessui/vue": "^1.7.23",
        "@inertiajs/react": "^3.7.1",
        "@inertiajs/vue3": "^3.7.1",
        "@monaco-editor/react": "^4.7.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.3",
        "axios": "^1.20.0",
        "laravel-echo": "^2.5.0",
        "laravel-vite-plugin": "^3.2.0",
        "lodash": "^4.18.1",
        "pusher-js": "^8.6.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "simplebar": "^6.3.3",
        "simplebar-react": "^3.3.2",
        "simplebar-vue": "^2.4.2",
        "tailwindcss": "^4.3.3",
        "toastify-js": "^1.12.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.0",
        "vue": "^3.5.42"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "concurrently": "^10.0.5",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "vue-tsc": "^3.3.11"
    },
    "prettier": {
        "semi": true,
        "tabWidth": 4,
        "singleQuote": true,
        "printWidth": 100,
        "trailingComma": "none",
        "bracketSameLine": true,
        "endOfLine": "lf",
        "vueIndentScriptAndStyle": true,
        "plugins": [
            "prettier-plugin-tailwindcss"
        ]
    }
}
